{
  // The console, checked against the browser it runs in. It is the one part of src/ that tsc does
  // not compile — a page bundled by vite, with the DOM in its lib and React's JSX factory rather
  // than ours — so it gets its own config here instead of bending the package's.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/cli/ui/console", "test/cli/ui/console"]
}
