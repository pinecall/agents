{
  // The browser pages, checked against the browser they run in. `src/cli/ui` is the one part of
  // src/ that tsc does not compile — pages bundled by vite, with the DOM in their lib and React's
  // JSX factory rather than ours — so they get their own config here instead of bending the
  // package's. Three directories: what both pages are (`shared`), the tenant's console, and the
  // operator's admin.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/cli/ui/shared",
    "src/cli/ui/console",
    "src/cli/ui/admin",
    "test/cli/ui/console",
    "test/cli/ui/pages"
  ]
}
