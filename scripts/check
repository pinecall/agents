#!/usr/bin/env bash
# Ring 0 for the whole repo: build, then lint, then test — in that order.
set -euo pipefail
cd "$(dirname "$0")/.."

# The build first, because what is published is checked too: dist/ has to compile, the console
# has to bundle, @pinecall/web has to emit its types. Nothing below NEEDS it — every package in
# the workspace exports its sources — so a red build is a finding of its own.
scripts/build
pnpm lint
pnpm -r lint
pnpm test
pnpm -r test
