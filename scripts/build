#!/usr/bin/env bash
# Everything that has to exist before the tree is whole, in the order it has to exist in.
# Idempotent — run it as often as you like.
set -euo pipefail
cd "$(dirname "$0")/.."

# The wire lives in the repo next door and is consumed through its dist, exactly as a published
# @pinecall/protocol would be. Nothing here reads its schema.
pnpm --filter @pinecall/protocol build

# The framework: src/ minus the console, into dist/.
pnpm exec tsc -p tsconfig.json

# The console is a browser program inside the package; vite writes it straight into
# dist/cli/ui/console, which is the path `pinecall ui` serves and the one `files` publishes.
pnpm exec vite build --config src/cli/ui/console/vite.config.ts

# The browser's own package, which installs without any of the above.
pnpm --filter @pinecall/web build
