#!/usr/bin/env bash
# What gets published, in the order it has to be made. Nothing here is needed to test, lint or
# run a checkout — every package exports its sources — except the console, which a browser can
# only read bundled. Idempotent; run it as often as you like.
set -euo pipefail
cd "$(dirname "$0")/.."

# The wire lives in the repo next door and is consumed through its dist, exactly as a published
# @pinecall/protocol would be. Nothing here reads its schema.
pnpm --filter @pinecall/protocol build

# The package: src/ into dist/. Nothing else is built here — the console is a repo of its own
# (../console), built into the gateway by the runtime's scripts/console.
pnpm exec tsc -p tsconfig.json
